# Environment variables for Modi Services
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ===========================
# DATABASE
# ===========================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/modi_services"

# ===========================
# NEXTAUTH / ADMIN AUTH
# ===========================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# Admin credentials (change before production)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2a$12$YourBcryptHashHere"

# ===========================
# BUSINESS CONTACT DETAILS
# ===========================
NEXT_PUBLIC_BUSINESS_PHONE="+91-XXXXXXXXXX"
NEXT_PUBLIC_BUSINESS_WHATSAPP="+91XXXXXXXXXX"
NEXT_PUBLIC_BUSINESS_EMAIL="info@modiservices.in"
NEXT_PUBLIC_BUSINESS_ADDRESS="Your Office Address, City, State, PIN"
NEXT_PUBLIC_BUSINESS_HOURS="Mon–Sat: 9:00 AM – 6:00 PM"

# ===========================
# CSV DATA FILES
# ===========================
# Path relative to project root (e.g., data/mutual_funds.csv)
CSV_DATA_DIR="data"
CSV_PRIMARY_FILE="mutual_funds.csv"
